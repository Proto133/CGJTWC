rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ PUBLIC READS (anyone can view the site content) ============
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Coach and volunteer bios shown on the public /staff page.
    match /staff/{staffId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidStaff();
      allow delete: if isAdmin();
    }

    // Live overrides for the values in src/config/organization.ts. Public
    // because it is public site content; the file remains the fallback.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings();
    }

    // Photo gallery. Designed ahead of the image hosting work: entries carry an
    // imageUrl today and can gain a storagePath once Cloud Storage exists.
    match /galleryItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Cached copy of the club's X posts, refreshed by the scheduled GitHub
    // Action. Nothing in the browser may write here, not even an admin: the
    // only writer is the Admin SDK in that job, which bypasses these rules
    // entirely. Denying writes outright means a stolen admin session cannot
    // put arbitrary markup on the home page.
    match /social/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Posts by other people that mention the club. This is third-party content
    // on a site for minors, so it is quarantined: the public can only read a
    // document once an admin has approved it, and admins can change nothing
    // except that decision. Creation belongs to the scheduled job alone.
    match /xMentions/{mentionId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if false;
      allow update: if isAdmin() && isValidMentionDecision();
      allow delete: if isAdmin();
    }

    // ============ WRESTLER REGISTRATIONS ============
    // These documents contain identifying information about minors: names,
    // dates of birth and home addresses. They are therefore WRITE-ONLY for the
    // public. Anyone may submit the form while signed out, but nobody except an
    // admin can ever read, change or delete a submission.
    match /registrations/{registrationId} {
      allow create: if isValidRegistration();
      allow read, delete: if isAdmin();
      // Confirming a payment must carry identifying detail, so the audit trail
      // cannot be skipped even by a buggy or malicious client.
      allow update: if isAdmin() && isValidRegistrationUpdate();
    }

    // ============ CONTACT FORM MESSAGES ============
    // Same shape as registrations: anyone may send one, nobody but an admin can
    // read them. Kept separate from `tickets` because tickets require an
    // authenticated admin to create, and relaxing that would let anyone write
    // into the internal tracker.
    match /contactMessages/{messageId} {
      allow create: if isValidContactMessage();
      allow read, delete: if isAdmin();
      // Any admin can triage; there is deliberately no owner gate here.
      allow update: if isAdmin() && isValidContactUpdate();
    }

    // ============ BUG REPORTS / FEATURE REQUESTS ============
    // Entirely internal: every operation requires an admin. Status is owner-only
    // so the backlog has a single decision maker, while any admin can file and
    // discuss.
    match /tickets/{ticketId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidTicket();
      allow update: if isOwner() && isValidTicketUpdate();
      allow delete: if isOwner();

      match /comments/{commentId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && isValidComment();
        // Comments are an audit trail of a conversation, so they are immutable.
        allow update: if false;
        allow delete: if isOwner()
                      || (isAdmin() && resource.data.authorUid == request.auth.uid);
      }
    }

    // ============ ACCOUNT VAULT ============
    // Stored account credentials. Passwords are encrypted in the browser before
    // they ever reach Firestore; the passphrase is never sent here. These rules
    // are the second line of defence, not the first.
    match /vaultMeta/{docId} {
      allow read, write: if isAdmin();
    }

    match /vaultItems/{itemId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && isValidVaultItem();
    }

    // ============ ADMIN ACCESS CONTROL ============
    // Only users whose UID exists as a document ID in /admins can write
    match /admins/{userId} {
      // Anyone can read the existence of their own admin doc (used by client to know if they are admin)
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only existing admins can manage the admins list (or bootstrap via console)
      allow write: if isAdmin();
    }

    // ============ PENDING ADMIN ACCESS REQUESTS ============
    // A newly signed-up user writes exactly one doc here, keyed by their own
    // UID. Approving someone = copying this doc ID into /admins/{uid}.
    // Creating a request grants NO privileges on its own.
    match /accessRequests/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && isValidAccessRequest();
      // Requests are private: only admins can review or clear them.
      allow read, update, delete: if isAdmin();
    }

    // ============ HELPERS ============

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // An admin whose record carries role == 'owner'. Admin documents without a
    // role default to a plain admin, so ownership has to be granted explicitly.
    function isOwner() {
      return isAdmin() &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid))
               .data.get('role', 'admin') == 'owner';
    }

    // Unauthenticated public write, so every field is whitelisted, length
    // capped and type checked, status cannot start as anything but 'new', and
    // createdAt must be the server's own clock.
    function isValidContactMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'message', 'status', 'createdAt'])
             && d.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt'])
             && d.name is string && d.name.size() > 0 && d.name.size() <= 100
             && d.email is string && d.email.size() <= 200
             && d.email.matches('^[^@]+@[^@]+[.][^@]+$')
             && d.message is string && d.message.size() > 0 && d.message.size() <= 5000
             && d.status == 'new'
             && d.createdAt == request.time;
    }

    // Triage may change status, owner and notes. What the sender actually wrote
    // is immutable, so a message cannot be quietly rewritten after the fact.
    function isValidContactUpdate() {
      let d = request.resource.data;
      let prior = resource.data;
      return d.keys().hasOnly(['name', 'email', 'message', 'status', 'createdAt',
                               'assignedTo', 'adminNotes', 'updatedAt', 'updatedBy'])
             && d.status in ['new', 'in-progress', 'resolved']
             && d.name == prior.name
             && d.email == prior.email
             && d.message == prior.message
             && d.createdAt == prior.createdAt
             && (!('assignedTo' in d.keys())
                 || (d.assignedTo is string && d.assignedTo.size() <= 120))
             && (!('adminNotes' in d.keys())
                 || (d.adminNotes is string && d.adminNotes.size() <= 4000));
    }

    // A moderator may only move a mention between states. Everything else is a
    // faithful record of what X returned, so allowing edits would let approved
    // content be swapped for something else after the fact.
    function isValidMentionDecision() {
      let d = request.resource.data;
      let prior = resource.data;
      return d.status in ['pending', 'approved', 'rejected']
             && d.id == prior.id
             && d.text == prior.text
             && d.permalink == prior.permalink
             && d.author == prior.author
             && d.media == prior.media
             && d.createdAt == prior.createdAt;
    }

    function isValidTicket() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'title', 'description', 'priority', 'pageUrl',
                               'status', 'createdByUid', 'createdByEmail',
                               'createdAt', 'updatedAt'])
             && d.keys().hasAll(['type', 'title', 'description', 'priority',
                                 'status', 'createdByUid', 'createdByEmail', 'createdAt'])
             && d.type in ['bug', 'feature']
             && d.title is string && d.title.size() > 0 && d.title.size() <= 140
             && d.description is string && d.description.size() <= 5000
             && d.priority in ['low', 'normal', 'high']
             && (!('pageUrl' in d.keys()) || (d.pageUrl is string && d.pageUrl.size() <= 500))
             // Everything starts open; only the owner advances it.
             && d.status == 'open'
             // Attribution cannot be forged.
             && d.createdByUid == request.auth.uid
             && d.createdByEmail is string
             && d.createdAt == request.time;
    }

    function isValidTicketUpdate() {
      let d = request.resource.data;
      let prior = resource.data;
      return d.status in ['open', 'in-progress', 'completed']
             && d.priority in ['low', 'normal', 'high']
             // Provenance is immutable.
             && d.createdByUid == prior.createdByUid
             && d.createdByEmail == prior.createdByEmail
             && d.createdAt == prior.createdAt
             && d.type == prior.type;
    }

    // The password must be a cipher blob rather than a bare string. This is a
    // structural guard: a coding mistake that tried to save a plaintext
    // password would be rejected by the database rather than silently stored.
    function isValidVaultItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['platform', 'label', 'username', 'url', 'recoveryEmail',
                               'twoFactor', 'owner', 'notes', 'password',
                               'createdAt', 'updatedAt', 'updatedBy'])
             && d.keys().hasAll(['platform', 'label', 'password'])
             && d.platform is string && d.platform.size() > 0 && d.platform.size() <= 60
             && d.label is string && d.label.size() > 0 && d.label.size() <= 120
             && d.password is map
             && d.password.keys().hasOnly(['ct', 'iv'])
             && d.password.keys().hasAll(['ct', 'iv'])
             && d.password.ct is string && d.password.ct.size() <= 4000
             && d.password.iv is string && d.password.iv.size() <= 64
             && (!('username' in d.keys()) || (d.username is string && d.username.size() <= 200))
             && (!('url' in d.keys()) || (d.url is string && d.url.size() <= 500))
             && (!('recoveryEmail' in d.keys())
                 || (d.recoveryEmail is string && d.recoveryEmail.size() <= 200))
             && (!('twoFactor' in d.keys()) || (d.twoFactor is string && d.twoFactor.size() <= 120))
             && (!('owner' in d.keys()) || (d.owner is string && d.owner.size() <= 120))
             && (!('notes' in d.keys()) || (d.notes is string && d.notes.size() <= 2000));
    }

    function isValidComment() {
      let d = request.resource.data;
      return d.keys().hasOnly(['body', 'authorUid', 'authorEmail', 'createdAt'])
             && d.keys().hasAll(['body', 'authorUid', 'authorEmail', 'createdAt'])
             && d.body is string && d.body.size() > 0 && d.body.size() <= 4000
             // You can only speak as yourself.
             && d.authorUid == request.auth.uid
             && d.authorEmail is string && d.authorEmail.size() <= 120
             && d.createdAt == request.time;
    }

    // Locks the shape of an access request so it cannot be used as free storage.
    function isValidAccessRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['firstName', 'lastName', 'email', 'phone', 'createdAt'])
             && d.keys().hasAll(['firstName', 'lastName', 'email', 'createdAt'])
             && d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 60
             && d.lastName is string && d.lastName.size() > 0 && d.lastName.size() <= 60
             // Prevents submitting a request under someone else's address.
             && d.email is string && d.email == request.auth.token.email
             && (!('phone' in d.keys()) || (d.phone is string && d.phone.size() <= 30))
             // Blocks backdating; serverTimestamp() resolves to request.time.
             && d.createdAt == request.time;
    }

    function isValidStaff() {
      let d = request.resource.data;
      return d.keys().hasOnly(['firstName', 'lastName', 'role', 'bio', 'order',
                               'email', 'photoUrl', 'createdAt', 'updatedAt'])
             && d.keys().hasAll(['firstName', 'lastName', 'role', 'bio', 'order'])
             && d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 60
             && d.lastName is string && d.lastName.size() > 0 && d.lastName.size() <= 60
             && d.role is string && d.role.size() > 0 && d.role.size() <= 80
             && d.bio is string && d.bio.size() <= 4000
             && d.order is int && d.order >= 0 && d.order <= 999
             && (!('email' in d.keys()) || (d.email is string && d.email.size() <= 120))
             && (!('photoUrl' in d.keys()) || (d.photoUrl is string && d.photoUrl.size() <= 500));
    }

    // Bounds the settings override document. Only the sections the app knows
    // about are accepted, so it cannot become arbitrary storage.
    function isValidSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly(['identity', 'contact', 'location', 'social',
                               'program', 'payment', 'content', 'updatedAt'])
             && (!('payment' in d.keys()) || d.payment is map)
             && (!('identity' in d.keys()) || d.identity is map)
             && (!('contact' in d.keys()) || d.contact is map)
             && (!('location' in d.keys()) || d.location is map)
             && (!('social' in d.keys()) || d.social is map)
             && (!('program' in d.keys()) || d.program is map)
             && (!('content' in d.keys()) || d.content is map);
    }

    // Strict validation for public registration submissions. Every field is
    // whitelisted, length-capped and type-checked; status cannot be set to
    // anything but 'new'; createdAt must be the server's own timestamp.
    function isValidRegistration() {
      let d = request.resource.data;
      return d.keys().hasOnly(['wrestler', 'guardian', 'address', 'emergency',
                               'payment', 'notes', 'status', 'createdAt'])
             && d.keys().hasAll(['wrestler', 'guardian', 'address', 'emergency',
                                 'payment', 'status', 'createdAt'])
             && validWrestler(d.wrestler)
             && validGuardian(d.guardian)
             && validAddress(d.address)
             && validEmergency(d.emergency)
             && validNewPayment(d.payment)
             && (!('notes' in d.keys()) || (d.notes is string && d.notes.size() <= 2000))
             // A submission always starts as 'new'; only admins can advance it.
             && d.status == 'new'
             && d.createdAt == request.time;
    }

    // What a registrant may declare about payment: their chosen method, the
    // tier they picked and its price, plus the memo reference. Crucially the
    // key whitelist excludes every confirmation field, so nobody can submit a
    // registration that claims to already be paid or invent a cheque number.
    function validNewPayment(p) {
      return p is map
             && p.keys().hasOnly(['method', 'tierId', 'amountDue', 'reference', 'status'])
             && p.keys().hasAll(['method', 'tierId', 'amountDue', 'reference', 'status'])
             && p.method in ['zelle', 'check', 'cash']
             && p.tierId is string && p.tierId.size() > 0 && p.tierId.size() <= 40
             && p.amountDue is number && p.amountDue >= 0 && p.amountDue <= 10000
             && p.reference is string && p.reference.matches('^[A-Z]{2,6}-[A-Z0-9]{4,8}$')
             // Only an admin can move a payment off 'unpaid'.
             && p.status == 'unpaid';
    }

    // Admin updates. Registrant-supplied identity blocks are immutable, and a
    // payment may only be marked 'paid' with the detail needed to trace it.
    function isValidRegistrationUpdate() {
      let d = request.resource.data;
      let prior = resource.data;
      return d.wrestler == prior.wrestler
             && d.guardian == prior.guardian
             && d.address == prior.address
             && d.emergency == prior.emergency
             && d.createdAt == prior.createdAt
             && d.status in ['new', 'contacted', 'registered']
             // Registrations submitted before payment tracking existed have no
             // payment block; they must stay editable.
             && (!('payment' in d.keys()) || validAdminPayment(d.payment));
    }

    function validAdminPayment(p) {
      return p is map
             && p.keys().hasOnly(['method', 'tierId', 'amountDue', 'reference', 'status',
                                  'confirmationRef', 'amountReceived', 'receivedAt',
                                  'depositedAt', 'confirmedBy', 'confirmedAt', 'notes'])
             && p.method in ['zelle', 'check', 'cash']
             && p.status in ['unpaid', 'pending', 'paid', 'waived']
             && p.reference is string
             // A settled payment must be traceable: some identifying reference,
             // a positive amount, and the date it arrived.
             && (p.status != 'paid' || (
                  p.confirmationRef is string && p.confirmationRef.size() > 0
                  && p.confirmationRef.size() <= 60
                  && p.amountReceived is number && p.amountReceived > 0
                  && p.receivedAt is string
                  && p.receivedAt.matches('^[0-9]{4}/[0-9]{2}/[0-9]{2}$')
                ))
             && (!('depositedAt' in p.keys()) || (
                  p.depositedAt is string
                  && p.depositedAt.matches('^[0-9]{4}/[0-9]{2}/[0-9]{2}$')
                ))
             && (!('notes' in p.keys()) || (p.notes is string && p.notes.size() <= 2000));
    }

    function validWrestler(w) {
      return w is map
             && w.keys().hasOnly(['firstName', 'lastName', 'dob', 'grade'])
             && w.keys().hasAll(['firstName', 'lastName', 'dob', 'grade'])
             && w.firstName is string && w.firstName.size() > 0 && w.firstName.size() <= 60
             && w.lastName is string && w.lastName.size() > 0 && w.lastName.size() <= 60
             && w.dob is string && w.dob.matches('^[0-9]{4}/[0-9]{2}/[0-9]{2}$')
             && w.grade is string && w.grade.size() > 0 && w.grade.size() <= 20;
    }

    function validGuardian(g) {
      return g is map
             && g.keys().hasOnly(['firstName', 'lastName', 'email', 'phone'])
             && g.keys().hasAll(['firstName', 'lastName', 'email', 'phone'])
             && g.firstName is string && g.firstName.size() > 0 && g.firstName.size() <= 60
             && g.lastName is string && g.lastName.size() > 0 && g.lastName.size() <= 60
             && g.email is string && g.email.size() <= 120
             && g.email.matches('^[^@]+@[^@]+[.][^@]+$')
             && g.phone is string && g.phone.size() > 0 && g.phone.size() <= 30;
    }

    function validAddress(a) {
      return a is map
             && a.keys().hasOnly(['street', 'city', 'state', 'postalCode'])
             && a.keys().hasAll(['street', 'city', 'state', 'postalCode'])
             && a.street is string && a.street.size() > 0 && a.street.size() <= 160
             && a.city is string && a.city.size() > 0 && a.city.size() <= 80
             && a.state is string && a.state.size() > 0 && a.state.size() <= 40
             && a.postalCode is string && a.postalCode.size() > 0 && a.postalCode.size() <= 12;
    }

    function validEmergency(e) {
      return e is map
             && e.keys().hasOnly(['name', 'phone', 'relationship'])
             && e.keys().hasAll(['name', 'phone', 'relationship'])
             && e.name is string && e.name.size() > 0 && e.name.size() <= 120
             && e.phone is string && e.phone.size() > 0 && e.phone.size() <= 30
             && e.relationship is string && e.relationship.size() > 0
             && e.relationship.size() <= 60;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
